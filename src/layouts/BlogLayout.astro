---
import Layout from "./Layout.astro";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  author?: string;
}

const { title, description, date, tags, author = "Shubham Salunke" } = Astro.props;

const formattedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(date);
---

<Layout title={title} description={description}>
  <article class="min-h-screen py-12">
    <div class="container max-w-4xl mx-auto px-6 md:px-4">
      <!-- Back Button -->
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-purple-500 transition-colors mb-8"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        Back to Blog
      </a>

      <!-- Blog Header -->
      <header class="mb-8">
        <h1
          class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-purple-500 to-pink-500 bg-clip-text text-transparent"
        >
          {title}
        </h1>
        <p class="text-xl text-muted-foreground mb-6">{description}</p>

        <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
          <div class="flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-purple-500"
            >
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
              <line x1="16" x2="16" y1="2" y2="6"></line>
              <line x1="8" x2="8" y1="2" y2="6"></line>
              <line x1="3" x2="21" y1="10" y2="10"></line>
            </svg>
            <time datetime={date.toISOString()}>{formattedDate}</time>
          </div>
          <div class="flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-purple-500"
            >
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>{author}</span>
          </div>
        </div>

        <!-- Tags -->
        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-4">
              {tags.map((tag) => (
                <span class="px-3 py-1 text-xs bg-purple-500/10 text-purple-600 dark:text-purple-400 rounded-full border border-purple-500/20">
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </header>

      <!-- Blog Content -->
      <div
        class="prose prose-lg dark:prose-invert max-w-none prose-headings:text-foreground prose-p:text-muted-foreground prose-a:text-purple-500 prose-a:no-underline hover:prose-a:underline prose-strong:text-foreground prose-code:text-purple-500 prose-code:bg-purple-500/10 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-pre:bg-muted prose-pre:border prose-pre:border-border"
      >
        <slot />
      </div>

      <!-- Share Section -->
      <div class="mt-12 pt-8 border-t border-border">
        <h3 class="text-lg font-semibold mb-4">Share this article</h3>
        <div class="flex gap-4">
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 bg-muted hover:bg-muted/80 rounded-lg transition-colors text-sm"
          >
            Twitter
          </a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 bg-muted hover:bg-muted/80 rounded-lg transition-colors text-sm"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  /* Custom styles for blog content */
  .prose img {
    border-radius: 0.5rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .prose pre {
    border-radius: 0.5rem;
    padding: 1.5rem;
  }

  .prose code {
    font-size: 0.875em;
  }

  .prose h2 {
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
  }

  .prose h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose ul,
  .prose ol {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose blockquote {
    border-left: 4px solid rgb(168 85 247);
    padding-left: 1.5rem;
    font-style: italic;
  }
</style>
