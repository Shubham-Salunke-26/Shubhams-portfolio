---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import MotionWrapper from "../../components/MotionWrapper";
import { GlassCard } from "../../components/ui/glass-card";

const allBlogPosts = await getCollection("blogs");

// Sort by date, newest first
const sortedPosts = allBlogPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
}
---

<Layout title="Blog - Shubham Salunke" description="DevOps and Cloud Engineering Blog">
  <main class="min-h-screen py-12 bg-gradient-to-b from-background to-muted/10">
    <div class="container max-w-4xl mx-auto px-6 md:px-4">
      <!-- Header -->
      <div class="mb-12">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-purple-500 transition-colors mb-6"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          Back to Home
        </a>
        <h1
          class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-purple-500 to-pink-500 bg-clip-text text-transparent"
        >
          Blog
        </h1>
        <p class="text-xl text-muted-foreground">
          Insights on DevOps, Cloud Engineering, and Infrastructure Automation
        </p>
      </div>

      <!-- Blog Posts Grid -->
      <div class="grid grid-cols-1 gap-6">
        {
          sortedPosts.map((post, index) => (
            <MotionWrapper delay={index * 0.1} client:load>
              <GlassCard className="group overflow-hidden dark:border-purple-500/10 hover:border-purple-500/30 transition-all duration-300">
                <a href={`/blog/${post.slug}`} class="block p-6">
                  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                    <div class="flex-grow">
                      <h2 class="text-2xl font-semibold mb-2 group-hover:text-purple-500 transition-colors duration-300">
                        {post.data.title}
                      </h2>
                      <p class="text-muted-foreground mb-4">
                        {post.data.description}
                      </p>
                      
                      {/* Tags */}
                      <div class="flex flex-wrap gap-2 mb-4">
                        {post.data.tags.map((tag) => (
                          <span class="text-xs px-2 py-1 bg-purple-500/10 text-purple-600 dark:text-purple-400 rounded-full">
                            {tag}
                          </span>
                        ))}
                      </div>

                      {/* Metadata */}
                      <div class="flex items-center gap-4 text-sm text-muted-foreground">
                        <div class="flex items-center gap-1">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="text-purple-500"
                          >
                            <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                            <line x1="16" x2="16" y1="2" y2="6" />
                            <line x1="8" x2="8" y1="2" y2="6" />
                            <line x1="3" x2="21" y1="10" y2="10" />
                          </svg>
                          <time datetime={post.data.date.toISOString()}>
                            {formatDate(post.data.date)}
                          </time>
                        </div>
                      </div>
                    </div>

                    {/* Read More Arrow */}
                    <div class="flex items-center justify-end md:justify-start">
                      <div class="flex items-center gap-2 text-purple-500 group-hover:gap-3 transition-all duration-300">
                        <span class="text-sm font-medium">Read More</span>
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="20"
                          height="20"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="m9 18 6-6-6-6" />
                        </svg>
                      </div>
                    </div>
                  </div>
                </a>
              </GlassCard>
            </MotionWrapper>
          ))
        }
      </div>

      {/* No posts message */}
      {
        sortedPosts.length === 0 && (
          <div class="text-center py-12">
            <p class="text-muted-foreground">No blog posts yet. Check back soon!</p>
          </div>
        )
      }
    </div>
  </main>
</Layout>
